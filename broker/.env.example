# Copy to .env and fill in both passwords. .env must stay out of version control.
MQTT_USERNAME=playpulse
MQTT_PASSWORD=

# The password for the staff web page. Required once it is on the network.
DASHBOARD_PASSWORD=

# Read by the dashboard's "npm run start:mqtt". Docker sets its own values.
ADAPTER=mqtt
MQTT_URL=mqtt://127.0.0.1:1883
PORT=4311
PLAYPULSE_DATA=data/mqtt.json
